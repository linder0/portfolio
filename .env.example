# Local env template. The real values live in Vercel (vercel env pull .env.local).

# Owner sign-in for /admin (editing marginalia captions).
# ADMIN_PASSWORD is the password you type; AUTH_SECRET signs the session
# cookie (generate with `openssl rand -hex 32`).
ADMIN_PASSWORD=
AUTH_SECRET=

# Vercel Blob store (persists edited captions). Auto-provisioned by
# `vercel blob create-store` + `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
