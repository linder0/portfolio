# Local env template. The real values live in Vercel (vercel env pull .env.local).

# Owner sign-in for /admin and inline editing.
# ADMIN_PASSWORD is the password you type; AUTH_SECRET signs the session
# cookie (generate with `openssl rand -hex 32`).
ADMIN_PASSWORD=
AUTH_SECRET=

# Upstash Redis persists notes, page/post/project edits, comments, and
# newsletter subscribers. A Vercel Marketplace integration supplies these.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Blob stores owner-uploaded images. A private Blob store supplies
# this token.
BLOB_READ_WRITE_TOKEN=
